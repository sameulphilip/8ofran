rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function hasForbiddenKeys() {
      return request.resource.data.keys().hasAny(['password', 'confession', 'exam']);
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if isOwner(uid) && !hasForbiddenKeys();
      allow delete: if false;
    }

    match /usernames/{name} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    match /priests/{id} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if false;
    }

    match /appointments/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && !hasForbiddenKeys();
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && !hasForbiddenKeys();
      allow delete: if false;
    }

    match /notifications/{id} {
      allow read, update: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if false;
    }
  }
}
